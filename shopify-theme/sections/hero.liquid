<!-- HERO SECTION -->
<section class="hero" id="hero">
    <div class="container">
        <div class="hero-content">
            <span class="hero-badge">✨ Bienestar que sí se disfruta</span>
            <h1>Haz espacio para<br><span class="highlight">tu mejor rutina.</span></h1>
            <p class="subtitle">
                Elige entre 13 sabores funcionales, arma tu ritual y recibe tus gomitas
                con envío gratis a toda Colombia.
            </p>
            <div class="hero-actions">
                <a href="#productos" class="btn btn-primary btn-large btn-pulse">
                    Ver mi gomita ideal →
                </a>
                <a href="#encuentra-tu-goma" class="hero-text-link">Hacer el quiz rápido</a>
            </div>
            <div class="hero-proof">
                <span>✓ Ingredientes seleccionados</span>
                <span>✓ Registro INVIMA</span>
                <span>✓ Compra segura</span>
            </div>
            <div class="hero-stats">
                <div class="stat">
                    <div class="stat-number" data-counter="15000">0</div>
                    <div class="stat-label">clientes felices</div>
                </div>
                <div class="stat">
                    <div class="stat-number" data-counter="13">0</div>
                    <div class="stat-label">opciones para elegir</div>
                </div>
                <div class="stat">
                    <div class="stat-number" data-counter="100" data-suffix="%">0</div>
                    <div class="stat-label">sabor para disfrutar</div>
                </div>
            </div>
        </div>
        <div class="hero-visual">
            <div class="hero-gummies">
                <div class="hero-orbit orbit-one"></div>
                <div class="hero-orbit orbit-two"></div>
                <div class="hero-circle"></div>
                <img class="hero-collage" src="{{ 'CLLGMS.png' | asset_url }}"
                    alt="Collage de las 13 gomitas saludables disponibles" width="600" height="600" loading="eager">
                <span class="hero-float-tag tag-one">13 fórmulas</span>
                <span class="hero-float-tag tag-two">Sabor + bienestar</span>
            </div>
        </div>
    </div>
</section>

{% schema %}
{
  "name": "Hero Principal",
  "settings": []
}
{% endschema %}

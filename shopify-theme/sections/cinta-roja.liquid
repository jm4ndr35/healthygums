<!-- CINTA ROJA INFERIOR DE COMPRAR AHORA -->
<section class="urgency-section cinta-roja" id="cinta-comprar-ahora">
    <div class="cinta-roja-marquee" aria-label="Aviso de compra y stock">
        <div class="cinta-roja-track">
            <div class="cinta-roja-group">
                <span>⚡ COMPRAR AHORA</span>
                <span class="cinta-sep">✦</span>
                <span>🛒 ENVÍO GRATIS A TODA COLOMBIA</span>
                <span class="cinta-sep">✦</span>
                <span>🔥 ÚLTIMAS UNIDADES EN INVENTARIO</span>
                <span class="cinta-sep">✦</span>
                <span>🔒 PAGO 100% SEGURO (PSE / NEQUI / EFECTY)</span>
                <span class="cinta-sep">✦</span>
                <span>✨ RESULTADOS REALES GARANTIZADOS</span>
                <span class="cinta-sep">✦</span>
            </div>
            <div class="cinta-roja-group" aria-hidden="true">
                <span>⚡ COMPRAR AHORA</span>
                <span class="cinta-sep">✦</span>
                <span>🛒 ENVÍO GRATIS A TODA COLOMBIA</span>
                <span class="cinta-sep">✦</span>
                <span>🔥 ÚLTIMAS UNIDADES EN INVENTARIO</span>
                <span class="cinta-sep">✦</span>
                <span>🔒 PAGO 100% SEGURO (PSE / NEQUI / EFECTY)</span>
                <span class="cinta-sep">✦</span>
                <span>✨ RESULTADOS REALES GARANTIZADOS</span>
                <span class="cinta-sep">✦</span>
            </div>
        </div>
    </div>
    <div class="container">
        <div class="urgency-content">
            <div class="urgency-message">
                <span class="urgency-icon-bounce">⚠️</span>
                <p>¡Solo quedan <strong id="stock-count">23</strong> unidades en inventario! La demanda es alta y el stock es limitado.</p>
            </div>
            <a href="#checkout" class="btn btn-comprar-roja">
                🛒 Comprar Ahora →
            </a>
        </div>
    </div>
</section>

{% schema %}
{
  "name": "Cinta Roja Comprar Ahora",
  "settings": []
}
{% endschema %}

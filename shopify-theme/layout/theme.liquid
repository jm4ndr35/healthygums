<!DOCTYPE html>
<html lang="{{ request.locale.iso_code | default: 'es' }}">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
        content="{{ page_description | default: 'Gomitas saludables premium — Colágeno, Biotina, Vitaminas y más. Sabor delicioso, resultados reales. Envío gratis a toda Colombia.' | escape }}">
    <title>
        {% if page_title %}
            {{ page_title }} | {{ shop.name }}
        {% else %}
            GOMAS SALUDABLES | Tu Bienestar en una Gomita 🍬
        {% endif %}
    </title>
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="icon"
        href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🍬</text></svg>">

    {{ content_for_header }}

    <link rel="stylesheet" href="{{ 'styles.css' | asset_url }}">
</head>

<body class="shopify-gomas-theme">
    {% section 'header' %}

    <main id="MainContent" role="main">
        {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    <!-- FLOATING CART BUTTON (MOBILE) -->
    <div class="floating-cart hidden" id="floating-cart">
        <a href="#checkout" class="floating-cart-btn">
            🛒 <span id="cart-count">{{ cart.item_count | default: 0 }}</span>
        </a>
    </div>

    <script src="{{ 'app.js' | asset_url }}" defer></script>
</body>

</html>
